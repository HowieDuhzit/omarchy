#!/bin/bash

# Returns true if any of the named packages are missing from the system (or false if they're all there).
# Supports pacman, apt, and pkg (Termux)

source "$HOME/.local/share/omarchy/install/helpers/proot.sh"

check_installed() {
  case $(proot_package_manager) in
    pacman)
      pacman -Q "$1" &>/dev/null
      ;;
    apt)
      dpkg -l "$1" &>/dev/null
      ;;
    pkg)
      pkg list-installed "$1" &>/dev/null
      ;;
    *)
      command -v "$1" &>/dev/null
      ;;
  esac
}

for pkg in "$@"; do
  if ! check_installed "$pkg"; then
    exit 0
  fi
done

exit 1
